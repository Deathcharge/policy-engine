{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.samsarix.com/policy-engine/v1/artifact.schema.json",
  "title": "Samsarix unsigned policy artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonicalization", "revision", "application", "policy", "tests", "sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "canonicalization": {"const": "samsarix-json-v1"},
    "revision": {"$ref": "#/$defs/identifier"},
    "application": {"$ref": "#/$defs/identifier"},
    "sha256": {"$ref": "#/$defs/digest"},
    "policy": {"$ref": "policy.schema.json"},
    "tests": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["suite_name", "suite_sha256", "case_count"],
          "properties": {
            "suite_name": {"type": "string", "minLength": 1, "maxLength": 128},
            "suite_sha256": {"$ref": "#/$defs/digest"},
            "case_count": {"type": "integer", "minimum": 1, "maximum": 1000}
          }
        }
      ]
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
