{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.samsarix.com/policy-engine/v1/batch.schema.json",
  "title": "Samsarix Policy Request Batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "requests"],
  "properties": {
    "schema_version": { "const": 1 },
    "requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "allOf": [
          {
            "$ref": "request.schema.json"
          },
          {
            "required": ["request_id"],
            "properties": {
              "request_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              }
            }
          }
        ]
      }
    }
  }
}
