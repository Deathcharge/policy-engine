{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Deathcharge/policy-engine/raw/main/policy_engine/schemas/test-suite.schema.json",
  "title": "Samsarix Policy Engine test suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "cases"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1, "maxLength": 16384},
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "request", "expect"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "request": {"$ref": "request.schema.json"},
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed"],
          "properties": {
            "allowed": {"type": "boolean"},
            "reason": {
              "enum": ["explicit_allow", "explicit_deny", "default_allow", "default_deny"]
            },
            "matched_rule_ids": {
              "type": "array",
              "maxItems": 512,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "maxLength": 128}
            }
          }
        }
      }
    }
  }
}
